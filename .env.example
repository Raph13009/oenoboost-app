# --- Supabase (client app) ---
# URL publique du projet (Project URL)
NEXT_PUBLIC_SUPABASE_URL="https://XXXXXXXXXXXX.supabase.co"
#  Publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# --- Supabase (serveur / backend / scripts) ---
# Secret key
SUPABASE_SERVICE_ROLE_KEY=""

# (Optionnel) Nom du schéma, si tu veux le rendre configurable
SUPABASE_SCHEMA="public"

# --- App URL (Stripe redirects & absolute links) ---
# Local: http://localhost:3000  |  Production: https://www.tondomaine.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Stripe (test: sk_test_…, price: price_…) ---
# Dashboard → Developers → API keys → Secret key
STRIPE_SECRET_KEY=""
# Dashboard → Developers → Webhooks → Signing secret (whsec_…)
# En local: `stripe listen --forward-to localhost:3000/api/webhooks/stripe` donne un whsec temporaire
STRIPE_WEBHOOK_SECRET=""
# Dashboard → Product catalog → Premium product → recurring Price ID
STRIPE_PRICE_ID_PREMIUM=""

# --- Mapbox (frontend map test) ---
# Public token for client-side map rendering
NEXT_PUBLIC_MAPBOX_TOKEN=""

# --- Account (profil > suppression de compte) ---
# Email affiché pour la demande de suppression définitive
NEXT_PUBLIC_ACCOUNT_DELETE_EMAIL="support@oenoboost.com"
